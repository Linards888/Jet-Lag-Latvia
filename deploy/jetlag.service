# Raspberry Pi / Linux systemd unit.  Install:
#   sudo cp deploy/jetlag.service /etc/systemd/system/jetlag.service
#   (edit User= and the paths below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now jetlag
[Unit]
Description=Jet Lag: Latvia game server
After=network-online.target
Wants=network-online.target

[Service]
User=rock
WorkingDirectory=/home/rock/Jet-Lag-Latvia
# Game data stays in ./data inside the repo (git-ignored), so `git pull` never touches it.
# noportf version: plain HTTP on port 8080, reachable from the home network (no GPS, no tunnel, no port forwarding).
ExecStart=/usr/bin/python3 server/app.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3
# A clean stop (SIGTERM) flushes the game state to disk first.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
